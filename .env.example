# ==============================================================================
# INDIE FEEDBACK - EXEMPLO DE VARIÁVEIS DE AMBIENTE (.env.example)
# Copie este arquivo para .env e preencha com seus valores reais.
# ==============================================================================

# 1. AUTENTICAÇÃO E DISCORD API
DISCORD_CLIENT_ID=seu_discord_client_id
DISCORD_CLIENT_SECRET=seu_discord_client_secret
DISCORD_BOT_TOKEN=seu_discord_bot_token
DISCORD_GUILD_ID=seu_discord_guild_id
DISCORD_FORUM_CHANNEL_ID=seu_discord_forum_channel_id
DISCORD_MOD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# 2. SEGURANÇA & SESSÃO
JWT_SECRET=sua_chave_secreta_jwt

# 3. AWS CREDENCIAIS & INFRAESTRUTURA
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=sua_aws_access_key_id
AWS_SECRET_ACCESS_KEY=sua_aws_secret_access_key
STAGE=dev

# TABELAS DYNAMODB & RECURSOS AWS (sem sufixo -dev/-prod)
USERS_TABLE=IndieFeedback-Users
GAMES_TABLE=IndieFeedback-Games
REVIEWS_TABLE=IndieFeedback-Reviews
BANNERS_BUCKET=indie-feedback-banners

# 4. FRONTEND (VITE)
VITE_API_BASE_URL=http://localhost:3000
VITE_DISCORD_CLIENT_ID=seu_discord_client_id
VITE_DISCORD_REDIRECT_URI=http://localhost:5173/auth/callback
